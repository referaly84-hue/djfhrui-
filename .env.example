# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional fallback / multi-key & model overrides
GEMINI_API_KEYS=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GEMINI_PROXY_URL=
GEMINI_PROXY_SECRET=

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server & Storage configuration (optional; defaults to port 3000 and local data/db.json)
PORT=3000
DATA_DIR=
ADMIN_CODE=
DATABASE_URL=
POSTGRES_URL=
PGSSL=

# Optional Firebase auth & Telegram notifications
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_FILE=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
